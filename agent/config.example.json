{
  "collector": "http://192.0.2.10:8080/ingest",
  "token_file": "/etc/tailpulse-agent/token",
  "host": "web-1",
  "disks": ["/"],
  "sources": [
    {
      "service": "shop-web",
      "path": "/var/log/nginx/access.log",
      "format": "timed",
      "rt_unit": "s"
    },
    {
      "service": "shop-api",
      "path": "/var/log/nginx/api.access.log",
      "format": "combined_rt",
      "rt_unit": "s",
      "exclude_path": "^/actuator/"
    }
  ],
  "alive": [
    { "service": "ws", "url": "http://127.0.0.1:3000/" }
  ]
}
