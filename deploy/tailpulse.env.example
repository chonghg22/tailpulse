# Copy to tailpulse.env (chmod 600). Never commit the real file.
# Generate values with: openssl rand -hex 32
TAILPULSE_INGEST_TOKEN=
TAILPULSE_VIEW_PASSWORD=
# File that holds the Slack incoming-webhook URL on one line (empty = no Slack alerts)
TAILPULSE_SLACK_WEBHOOK_FILE=
# Alert language: en or ko
TAILPULSE_LANG=en
# Day boundary for the "Today" tab, e.g. Asia/Seoul (empty = server time zone)
TAILPULSE_ZONE=
